# Copy to .env. Demo runs without any keys. Never commit .env.
HOST=127.0.0.1
PORT=1340
# Required (24+ random characters) before enabling any credentials or real data.
DASHBOARD_TOKEN=
ALLOW_REAL_DATA=false
NIGHTSCOUT_URL=
# Use a dedicated read-only Nightscout access token; sent as api-secret header.
NIGHTSCOUT_TOKEN=
# OpenRouter or another compatible /chat/completions endpoint.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Comma-separated model IDs available in your provider account.
AI_MODELS=
# Optional separate OpenAI-compatible images/generations provider.
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=
# GPT image models: false. Legacy compatible services may need true.
IMAGE_LEGACY_RESPONSE_FORMAT=false
# Reservations are configurable estimates, NOT provider billing guarantees.
# Set these at or above the maximum request cost for ALL enabled models.
DAILY_BUDGET_USD=1.00
TEXT_REQUEST_RESERVE_USD=0.10
IMAGE_REQUEST_RESERVE_USD=0.25
DAILY_REQUEST_LIMIT=20
CACHE_TTL_SECONDS=300
BUDGET_FILE=.data/budget.json
