# Copy to .env. Demo runs without any keys. Never commit .env.
HOST=127.0.0.1
PORT=1340
# Required (24+ random characters) before enabling any credentials or real data.
DASHBOARD_TOKEN=
ALLOW_REAL_DATA=false
NIGHTSCOUT_URL=
# Use a dedicated read-only Nightscout access token; sent as api-secret header.
NIGHTSCOUT_TOKEN=
# OpenRouter or another compatible /chat/completions endpoint.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Comma-separated model IDs available in your provider account.
AI_MODELS=
# Optional art adapter: openai (default) or openrouter (chat image output).
IMAGE_PROVIDER=openai
# Keep the OpenAI endpoint below, or for openrouter use https://openrouter.ai/api/v1.
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=
# openai adapter only: GPT image models false; legacy services may need true.
IMAGE_LEGACY_RESPONSE_FORMAT=false
# openrouter only: image,text for multimodal models; image for image-only models.
IMAGE_MODALITIES=image,text
# Chat output cap INCLUDING image tokens; must be an integer 1..32768.
# A low cap may truncate images. Include this cap in your spending reservation.
IMAGE_MAX_TOKENS=8192
# OpenRouter alternative (replace the IMAGE_* values above):
# IMAGE_PROVIDER=openrouter
# IMAGE_BASE_URL=https://openrouter.ai/api/v1
# IMAGE_API_KEY=<your OpenRouter key; remains server-side>
# IMAGE_MODEL=<chat model with image in architecture.output_modalities>
# No automatic credential fallback: explicitly set IMAGE_API_KEY even if it
# uses the same key as AI_API_KEY. No second provider account is required.
# Reservations are configurable estimates, NOT provider billing guarantees.
# Set these at or above the maximum request cost for ALL enabled models.
DAILY_BUDGET_USD=1.00
TEXT_REQUEST_RESERVE_USD=0.10
IMAGE_REQUEST_RESERVE_USD=0.25
DAILY_REQUEST_LIMIT=20
CACHE_TTL_SECONDS=300
BUDGET_FILE=.data/budget.json
